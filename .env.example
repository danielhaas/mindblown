DATABASE_URL=postgresql://mindblown:mindblown@localhost:5433/mindblown
PORT=3001

# GitHub App (create at https://github.com/settings/apps/new)
GITHUB_APP_ID=
GITHUB_APP_NAME=                     # URL slug, e.g. "mindblown-by-project-li"
GITHUB_APP_CLIENT_ID=                # Starts with Iv...
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_WEBHOOK_SECRET=           # openssl rand -hex 32
GITHUB_APP_PRIVATE_KEY=              # Base64-encoded .pem: cat key.pem | base64 -w0
GITHUB_OAUTH_CALLBACK_URL=https://your-domain/api/auth/github/install/callback

# Encryption for secrets at rest
ENCRYPTION_KEY=                      # openssl rand -base64 32

# User feedback → GitHub issue bridge (the "Report an issue" button).
# Uses a dedicated PAT so reports always land in one operator-owned repo,
# independent of whichever repo each user has connected for sync.
FEEDBACK_GITHUB_PAT=                 # PAT with `repo` scope on the target repo
FEEDBACK_GITHUB_REPO=                # owner/repo, e.g. "dhaas/mindblown"

# Which GitHub login's issue-closes the abandoned-PR reopen path may undo.
# Leave EMPTY: it is derived as "${GITHUB_APP_NAME}[bot]", which is what a
# GitHub App's bot login always is. Set it only for an installation whose
# bot login genuinely differs — and then keep it consistent with
# GITHUB_APP_NAME, because a mismatch makes every close look like somebody
# else's and silently disables the reopen path (the skip is logged).
MINDBLOWN_BOT_LOGIN=
